NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional social login; all disabled by default. Flags are public runtime config.
# Hosted Supabase: also enable these providers and manual identity linking in Auth.
# Self-hosted Supabase: credentials below are passed only to the Auth container.
AUTH_GOOGLE_ENABLED=false
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_SECRET=
AUTH_FACEBOOK_ENABLED=false
AUTH_FACEBOOK_CLIENT_ID=
AUTH_FACEBOOK_SECRET=
AUTH_GITHUB_ENABLED=false
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_SECRET=

# Email delivery over SMTP: server-only; required for group invitation emails.
# Service-role key enables direct sign-in in invitation emails and is required
# for optional competition-start emails. Keep it server-only.
SUPABASE_SERVICE_ROLE_KEY=
# e.g. smtp.gmail.com with port 587 (STARTTLS) and a Google app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender address (bare address); for Gmail, the account or a verified alias.
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=OpenJury
# Trusted public origin, e.g. https://jury.example.com (no path/query).
APP_URL=

# Optional iOS Home Screen web push (server-only VAPID configuration).
# Generate once: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# Contact URI, e.g. mailto:admin@example.com or https://jury.example.com/contact
WEB_PUSH_SUBJECT=
# At least 32 random characters; protects automatic scheduled dispatch.
WEB_PUSH_DISPATCH_SECRET=
